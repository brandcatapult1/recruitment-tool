<%- include('../partials/header') %>
<div class="card">
  <div class="card-head">
    <h1>Staff</h1>
    <a class="button primary" href="/staff/new">Add staff member</a>
  </div>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Department</th>
        <th>Role</th>
        <th>Email</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% for (const member of staff) { %>
        <tr class="<%= member.active ? '' : 'inactive' %>">
          <td><%= member.name %></td>
          <td><%= member.department || '—' %></td>
          <td><%= member.system_role %></td>
          <td><%= member.email || '—' %></td>
          <td><%= member.active ? 'Active' : 'Deactivated' %></td>
          <td class="actions">
            <a href="/staff/<%= member.staff_id %>/edit">Edit</a>
            <% if (member.active) { %>
              <form method="post" action="/staff/<%= member.staff_id %>/deactivate" class="inline">
                <button type="submit" class="link-button danger">Deactivate</button>
              </form>
            <% } else { %>
              <form method="post" action="/staff/<%= member.staff_id %>/reactivate" class="inline">
                <button type="submit" class="link-button">Reactivate</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
  <p class="muted">Deactivation preserves historical attribution: deactivated staff disappear from
    interviewer dropdowns but remain on past rounds, screens and events.</p>
</div>
<%- include('../partials/footer') %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Brand Catapult — HR Pulse</title>
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/static/styles.css?v=a1">
</head>
<body>
<div class="page<%= typeof user !== 'undefined' && user ? ' has-sidebar' : '' %>">
<div class="aurora" aria-hidden="true">
  <div class="aurora-base"></div>
  <div class="aurora-v"></div>
  <div class="aurora-o"></div>
  <div class="aurora-t"></div>
</div>
<%
  const here = typeof path === 'string' ? path : '';
  function navOn(prefix) {
    if (prefix === '/') return here === '/';
    return here === prefix || here.startsWith(prefix + '/');
  }
%>
<% if (typeof user !== 'undefined' && user) { %>
<aside id="sidebar" class="sidebar">
  <a class="sidebar-brand" href="/">
    <img src="/static/favicon.svg" alt="" width="32" height="32">
    <span>Brand Catapult — HR Pulse</span>
  </a>
  <nav>
    <a href="/" class="<%= navOn('/') ? 'active' : '' %>">Home</a>
    <a href="/campaigns" class="<%= navOn('/campaigns') ? 'active' : '' %>">Campaigns</a>
    <a href="/questions" class="<%= navOn('/questions') ? 'active' : '' %>">Questions</a>
    <% if (user.role === 'admin') { %>
      <a href="/brands" class="<%= navOn('/brands') ? 'active' : '' %>">Brands</a>
      <a href="/departments" class="<%= navOn('/departments') ? 'active' : '' %>">Departments</a>
      <a href="/staff" class="<%= navOn('/staff') ? 'active' : '' %>">Staff</a>
    <% } %>
    <% if (user.role === 'partner') { %>
      <a href="/leadership" class="<%= navOn('/leadership') ? 'active' : '' %>">Leadership Overview</a>
    <% } %>
  </nav>
  <div class="sidebar-session">
    <div class="who"><%= user.name %></div>
    <div class="muted"><%= label('role', user.role) %></div>
    <form method="post" action="/logout">
      <button type="submit" class="btn-ghost">Sign out</button>
    </form>
  </div>
</aside>
<div class="sidebar-backdrop" id="sidebar-backdrop" hidden></div>
<% } %>
<div class="frame">
<% if (typeof user !== 'undefined' && user) { %>
  <header class="mobile-bar">
    <button type="button" class="sidebar-toggle" id="sidebar-open" aria-label="Open menu">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
    <span class="brand">Brand Catapult — HR Pulse</span>
  </header>
<% } %>
<div class="shell">
<% if (typeof user === 'undefined' || !user) { %>
<header class="topbar campaign-glass-tile">
  <a class="brand" href="/">Brand Catapult — HR Pulse</a>
</header>
<% } %>
<main class="content">
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="flash <%= flash.type %>" role="status"><%= flash.message %></div>
  <% } %>

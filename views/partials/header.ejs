<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Brand Catapult — HR Pulse</title>
  <link rel="stylesheet" href="/static/styles.css">
</head>
<body>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/">Brand Catapult — HR Pulse</a>
    <% if (user) { %>
      <nav class="nav">
        <a href="/">Home</a>
        <a href="/campaigns">Campaigns</a>
        <a href="/questions">Questions</a>
        <% if (user.role === 'admin') { %><a href="/departments">Departments</a><a href="/staff">Staff</a><% } %>
        <% if (user.role === 'partner') { %><a href="/leadership">Leadership Overview</a><% } %>
      </nav>
      <div class="session">
        <span class="who"><%= user.name %> · <%= label('role', user.role) %></span>
        <form method="post" action="/logout" class="inline"><button type="submit" class="link-button">Sign out</button></form>
      </div>
    <% } %>
  </div>
</header>
<main class="content">
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="flash <%= flash.type %>" role="status"><%= flash.message %></div>
  <% } %>

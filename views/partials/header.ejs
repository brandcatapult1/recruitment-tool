<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Brand Catapult — HR Pulse</title>
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/static/styles.css?v=glass3">
</head>
<body>
<div class="page">
<div class="aurora" aria-hidden="true">
  <div class="aurora-base"></div>
  <div class="aurora-v"></div>
  <div class="aurora-o"></div>
  <div class="aurora-t"></div>
</div>
<div class="shell">
<%
  const here = typeof path === 'string' ? path : '';
  function navOn(prefix) {
    if (prefix === '/') return here === '/';
    return here === prefix || here.startsWith(prefix + '/');
  }
%>
<header class="topbar campaign-glass-tile">
  <a class="brand" href="/">Brand Catapult — HR Pulse</a>
  <% if (user) { %>
    <nav class="nav">
      <a href="/" class="<%= navOn('/') ? 'active' : '' %>">Home</a>
      <a href="/campaigns" class="<%= navOn('/campaigns') ? 'active' : '' %>">Campaigns</a>
      <a href="/questions" class="<%= navOn('/questions') ? 'active' : '' %>">Questions</a>
      <% if (user.role === 'admin') { %>
        <a href="/departments" class="<%= navOn('/departments') ? 'active' : '' %>">Departments</a>
        <a href="/staff" class="<%= navOn('/staff') ? 'active' : '' %>">Staff</a>
      <% } %>
      <% if (user.role === 'partner') { %>
        <a href="/leadership" class="<%= navOn('/leadership') ? 'active' : '' %>">Leadership Overview</a>
      <% } %>
    </nav>
    <div class="session">
      <span class="who"><%= user.name %> · <%= label('role', user.role) %></span>
      <form method="post" action="/logout" class="inline">
        <button type="submit" class="btn-ghost">Sign out</button>
      </form>
    </div>
  <% } %>
</header>
<main class="content">
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="flash <%= flash.type %>" role="status"><%= flash.message %></div>
  <% } %>

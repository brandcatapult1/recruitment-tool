<%- include('../partials/header') %>
<%
  const attachedIds = new Set(attached.map((q) => q.question_id));
  const orderById = {};
  const requiredById = {};
  const knockoutById = {};
  for (const q of attached) {
    orderById[q.question_id] = q.display_order;
    requiredById[q.question_id] = q.is_required;
    knockoutById[q.question_id] = q.is_knockout;
  }
%>
<div class="card">
  <div class="card-head">
    <h1><%= campaign.role_title %></h1>
    <a class="button primary" href="/campaigns/<%= campaign.campaign_id %>/edit">Edit campaign</a>
  </div>
  <p class="muted"><%= campaign.department %> · <%= campaign.status %> · <%= campaign.positions_open %> open
    · <%= campaign.assignment_stage_enabled ? 'Assignment stage on' : 'Assignment stage off' %></p>

  <h2>Pipeline stages</h2>
  <ol class="stage-preview">
    <% for (const stage of stages) { %>
      <li><%= stage %></li>
    <% } %>
  </ol>
  <% if (!campaign.assignment_stage_enabled) { %>
    <p class="muted">Assignment is off, so this campaign goes from screened straight to interviewing.</p>
  <% } %>

  <h2>Apply links</h2>
  <p class="muted">The public apply page arrives in M2. Until then these URLs 404 — that is expected.
    Each source has its own URL and stamps that source on the resulting application. A missing or
    mangled source still accepts the application, tagged <code>other</code>.</p>
  <p>Bare link (stamps <code>other</code>): <code><%= applyUrl %></code></p>
  <table>
    <thead><tr><th>Source</th><th>URL</th></tr></thead>
    <tbody>
      <% for (const link of sourceLinks) { %>
        <tr>
          <td><%= link.source %></td>
          <td><code><%= link.url %></code></td>
        </tr>
      <% } %>
    </tbody>
  </table>

  <h2>Apply-page questions</h2>
  <p class="muted">Knockout flags tag and triage only. They never auto-reject and never change a stage.</p>
  <form method="post" action="/campaigns/<%= campaign.campaign_id %>/questions">
    <table>
      <thead>
        <tr>
          <th>Include</th>
          <th>Question</th>
          <th>Order</th>
          <th>Required</th>
          <th>Knockout</th>
        </tr>
      </thead>
      <tbody>
        <% if (selectable.length === 0) { %>
          <tr><td colspan="5" class="muted">No questions in the bank yet. <a href="/questions/new">Add one</a>.</td></tr>
        <% } %>
        <% selectable.forEach((q, i) => { %>
          <tr class="<%= q.active ? '' : 'inactive' %>">
            <td>
              <input type="checkbox" name="selected" value="<%= q.question_id %>" <%= attachedIds.has(q.question_id) ? 'checked' : '' %>>
            </td>
            <td><%= q.text %> <span class="muted"><%= q.type %><%= q.active ? '' : ' · inactive' %></span></td>
            <td>
              <input type="number" name="order_<%= q.question_id %>" min="1" step="1" value="<%= orderById[q.question_id] || (i + 1) %>" class="order-input">
            </td>
            <td>
              <input type="checkbox" name="required_<%= q.question_id %>" <%= requiredById[q.question_id] ? 'checked' : '' %>>
            </td>
            <td>
              <input type="checkbox" name="knockout_<%= q.question_id %>" <%= knockoutById[q.question_id] ? 'checked' : '' %>>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div class="form-actions">
      <button type="submit" class="primary">Save questions</button>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>

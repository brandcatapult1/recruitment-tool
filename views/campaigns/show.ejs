<%- include('../partials/header') %>
<%
  const attachedIds = new Set(attached.map((q) => q.question_id));
  const orderById = {};
  const requiredById = {};
  const knockoutById = {};
  for (const q of attached) {
    orderById[q.question_id] = q.display_order;
    requiredById[q.question_id] = q.is_required;
    knockoutById[q.question_id] = q.is_knockout;
  }
%>
<div class="card campaign-glass-tile">
  <div class="card-head">
    <h1><%= campaign.role_title %></h1>
    <a class="button primary" href="/campaigns/<%= campaign.campaign_id %>/edit">Edit campaign</a>
  </div>
  <p class="muted"><%= campaign.department_name %> · <%= label('campaignStatus', campaign.status) %> · <%= campaign.positions_open %> open
    · salary <%= campaign.show_salary_publicly ? 'public' : 'hidden' %></p>

  <h2>Pipeline stages</h2>
  <ol class="stage-preview">
    <% for (const stage of stages) { %><li><%= label('stage', stage) %></li><% } %>
  </ol>
  <p class="muted">Every campaign uses the same eight stages. Assignment is used per candidate when needed.</p>

  <h2>Inherited from <%= campaign.department_name %></h2>
  <p class="muted">Qualifiers, dimensions and department apply questions are set on the department.
    <% if (user.role === 'admin') { %><a href="/departments/<%= campaign.department_id %>">Edit at department</a><% } %></p>
  <p><strong>Qualifiers:</strong>
    <%= department && department.screening_qualifiers && department.screening_qualifiers.length
      ? department.screening_qualifiers.join(' · ') : 'None' %></p>
  <p><strong>Dimensions:</strong>
    <%= department && department.feedback_dimensions && department.feedback_dimensions.length
      ? department.feedback_dimensions.join(' · ') : 'None' %></p>
  <% if (departmentQuestions.length) { %>
    <p><strong>Department apply questions:</strong></p>
    <ul><% for (const q of departmentQuestions) { %><li><%= q.text %> <span class="muted"><%= label('questionType', q.type) %></span></li><% } %></ul>
  <% } else { %>
    <p class="muted">No department apply questions yet.</p>
  <% } %>

  <h2>Apply links</h2>
  <p class="muted">Each source has its own URL. A missing or mangled source still accepts the application, tagged <%= label('source', 'other') %>. Closed or on-hold campaigns 404 at these URLs.</p>
  <p>Bare link (stamps <%= label('source', 'other') %>): <code><%= applyUrl %></code></p>
  <table>
    <thead><tr><th>Source</th><th>URL</th></tr></thead>
    <tbody>
      <% for (const link of sourceLinks) { %>
        <tr><td><%= label('source', link.source) %></td><td><code><%= link.url %></code></td></tr>
      <% } %>
    </tbody>
  </table>

  <h2>Campaign apply questions</h2>
  <p class="muted">Up to <%= maxCampaignQuestions %>. At most <%= maxFreeText %> may be free text (500 characters each).
    Knockout flags tag and triage only — they never auto-reject.</p>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form method="post" action="/campaigns/<%= campaign.campaign_id %>/questions">
    <table>
      <thead>
        <tr>
          <th>Include</th>
          <th>Question</th>
          <th>Order</th>
          <th>Required</th>
          <th>Knockout</th>
        </tr>
      </thead>
      <tbody>
        <% if (selectable.length === 0) { %>
          <tr><td colspan="5" class="muted">No questions in the bank yet. <a href="/questions/new">Add one</a>.</td></tr>
        <% } %>
        <% selectable.forEach((q, i) => { %>
          <tr class="<%= q.active ? '' : 'inactive' %>">
            <td><input type="checkbox" name="selected" value="<%= q.question_id %>" <%= attachedIds.has(q.question_id) ? 'checked' : '' %>></td>
            <td><%= q.text %> <span class="muted"><%= label('questionType', q.type) %><%= q.active ? '' : ' · inactive' %></span></td>
            <td><input type="number" name="order_<%= q.question_id %>" min="1" class="order-input" value="<%= orderById[q.question_id] || (i + 1) %>"></td>
            <td><input type="checkbox" name="required_<%= q.question_id %>" <%= requiredById[q.question_id] ? 'checked' : '' %>></td>
            <td><input type="checkbox" name="knockout_<%= q.question_id %>" <%= knockoutById[q.question_id] ? 'checked' : '' %>></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div class="form-actions"><button type="submit" class="primary">Save questions</button></div>
  </form>
</div>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<%
  function field(name, fallback) {
    if (!campaign) return fallback || '';
    const v = campaign[name];
    if (v == null || v === '') return fallback || '';
    return v;
  }
  const showSalary = !(campaign && (campaign.show_salary_publicly === false || campaign.show_salary_publicly === 'false'));
  const currentDept = field('department_id');
%>
<div class="card">
  <h1><%= title %></h1>
  <p class="muted">One screen. Qualifiers and interview dimensions live on the department, not here.</p>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form method="post" class="campaign-form">
    <div class="grid-2">
      <label>Role title
        <input type="text" name="role_title" required value="<%= field('role_title') %>" autofocus>
      </label>
      <label>Department
        <select name="department_id" required>
          <option value="" disabled <%= currentDept ? '' : 'selected' %>>Select a department</option>
          <% for (const d of departments) { %>
            <option value="<%= d.department_id %>" <%= currentDept === d.department_id ? 'selected' : '' %>><%= d.name %></option>
          <% } %>
        </select>
      </label>
      <label>Positions open
        <input type="number" name="positions_open" min="1" step="1" value="<%= field('positions_open', 1) %>">
      </label>
      <% if (mode === 'edit') { %>
        <label>Status
          <select name="status">
            <% for (const s of statuses) { %>
              <option value="<%= s %>" <%= field('status', 'open') === s ? 'selected' : '' %>><%= s %></option>
            <% } %>
          </select>
        </label>
      <% } %>
      <label>Salary band min
        <input type="number" name="salary_band_min" value="<%= field('salary_band_min') %>">
      </label>
      <label>Salary band max
        <input type="number" name="salary_band_max" value="<%= field('salary_band_max') %>">
      </label>
    </div>
    <label class="check">
      <input type="checkbox" name="show_salary_publicly" value="true" <%= showSalary ? 'checked' : '' %>>
      Show salary band on the public apply page
    </label>
    <label>Job description
      <textarea name="job_description" rows="8" required><%= field('job_description') %></textarea>
    </label>
    <label>Process description <span class="muted">(shown on the apply page)</span>
      <textarea name="process_description" rows="3"><%= field('process_description', defaultProcess) %></textarea>
    </label>
    <label>Expected timeline
      <input type="text" name="expected_timeline" value="<%= field('expected_timeline', defaultTimeline) %>">
    </label>
    <label>Public URL slug <span class="muted">(leave blank to generate from the role title)</span>
      <input type="text" name="public_slug" value="<%= field('public_slug') %>" placeholder="senior-copywriter">
    </label>
    <div class="form-actions">
      <button type="submit" class="primary">Save campaign</button>
      <a href="/campaigns">Cancel</a>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<%
  function field(name, fallback) {
    if (!campaign) return fallback || '';
    const v = campaign[name];
    if (v == null || v === '') return fallback || '';
    return v;
  }
  const showSalary = !(campaign && (campaign.show_salary_publicly === false || campaign.show_salary_publicly === 'false'));
  const currentDept = field('department_id');
  const currentBrand = field('brand_id');
%>
<div class="card campaign-glass-tile">
  <h1><%= title %></h1>
  <p class="muted">One screen. Qualifiers and interview dimensions live on the department, not here.</p>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form method="post" class="campaign-form">
    <div class="grid-2">
      <label>Role title
        <input type="text" name="role_title" required value="<%= field('role_title') %>" autofocus>
      </label>
      <% if (mode === 'create') { %>
        <label>Brand
          <span class="muted">Brand can't be changed later.</span>
          <select name="brand_id" id="brand-select" required>
            <option value="" disabled <%= currentBrand ? '' : 'selected' %>>Select a brand</option>
            <% for (const b of brands) { %>
              <option value="<%= b.brand_id %>" <%= currentBrand === b.brand_id ? 'selected' : '' %>><%= b.name %></option>
            <% } %>
          </select>
        </label>
      <% } else { %>
        <label>Brand
          <span class="muted">Set at creation and can't be changed.</span>
          <input type="text" value="<%= campaign.brand_name || '' %>" disabled>
        </label>
      <% } %>
      <label>Department
        <select name="department_id" id="department-select" required>
          <option value="" disabled <%= currentDept ? '' : 'selected' %>>Select a department</option>
          <% for (const d of departments) { %>
            <option value="<%= d.department_id %>" data-brand="<%= d.brand_id %>" <%= currentDept === d.department_id ? 'selected' : '' %>><%= d.name %></option>
          <% } %>
        </select>
      </label>
      <label>Positions open
        <input type="number" name="positions_open" min="1" step="1" value="<%= field('positions_open', 1) %>">
      </label>
      <% if (mode === 'edit') { %>
        <label>Status
          <select name="status">
            <% for (const s of statuses) { %>
              <option value="<%= s %>" <%= field('status', 'open') === s ? 'selected' : '' %>><%= label('campaignStatus', s) %></option>
            <% } %>
          </select>
        </label>
      <% } %>
      <label>Salary band min
        <input type="number" name="salary_band_min" value="<%= field('salary_band_min') %>">
      </label>
      <label>Salary band max
        <input type="number" name="salary_band_max" value="<%= field('salary_band_max') %>">
      </label>
    </div>
    <label class="check">
      <input type="checkbox" name="show_salary_publicly" value="true" <%= showSalary ? 'checked' : '' %>>
      Show salary band on the public apply page
    </label>
    <label>Job description
      <div id="jd-editor"></div>
      <textarea name="job_description" id="jd-input" required rows="8"><%= field('job_description') %></textarea>
    </label>
    <label>Public URL slug <span class="muted">(leave blank to generate from the role title)</span>
      <input type="text" name="public_slug" value="<%= field('public_slug') %>" placeholder="senior-copywriter">
    </label>
    <div class="form-actions">
      <button type="submit" class="primary">Save campaign</button>
      <a class="btn-secondary" href="/campaigns">Cancel</a>
    </div>
  </form>
</div>
<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script>
(function () {
  var input = document.getElementById('jd-input');
  if (!input || typeof Quill === 'undefined') return;
  var quill = new Quill('#jd-editor', {
    theme: 'snow',
    modules: {
      toolbar: [
        ['bold', 'italic'],
        [{ list: 'ordered' }, { list: 'bullet' }],
        [{ header: 2 }, { header: 3 }]
      ]
    }
  });
  input.hidden = true;
  if (input.value) {
    if (/<\/?[a-z][\s\S]*>/i.test(input.value)) {
      quill.clipboard.dangerouslyPasteHTML(input.value);
    } else {
      quill.setText(input.value);
    }
  }
  function sync() { input.value = quill.root.innerHTML; }
  quill.on('text-change', sync);
  input.closest('form').addEventListener('submit', function () {
    sync();
    if (!quill.getText().trim()) {
      input.setCustomValidity('Job description is required.');
    } else {
      input.setCustomValidity('');
    }
  });
})();
</script>
<script>
(function () {
  var brand = document.getElementById('brand-select');
  var dept = document.getElementById('department-select');
  if (!dept) return;
  var lockedBrand = <%= mode === 'edit' ? JSON.stringify(String(campaign.brand_id || '')) : 'null' %>;
  function filterDepts() {
    var brandId = lockedBrand || (brand && brand.value) || '';
    var options = dept.querySelectorAll('option[data-brand]');
    var keep = dept.value;
    options.forEach(function (opt) {
      var match = Boolean(brandId) && opt.getAttribute('data-brand') === brandId;
      opt.hidden = !match;
      opt.disabled = !match;
    });
    var selected = dept.selectedOptions[0];
    if (selected && selected.disabled) dept.value = '';
  }
  if (brand) brand.addEventListener('change', filterDepts);
  filterDepts();
})();
</script>
<%- include('../partials/footer') %>

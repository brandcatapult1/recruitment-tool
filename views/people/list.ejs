<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1 class="page-title">People</h1>
    <p class="page-sub">One record per person, across every brand. Search name, phone, email, tags, role, or notes.</p>
  </div>
  <a class="btn-secondary" href="/people/export.csv<%= q ? '?q=' + encodeURIComponent(q) : '' %>">Export CSV</a>
</div>
<section class="card campaign-glass-tile">
  <form method="get" action="/people" class="filter-bar">
    <label>Search
      <input type="search" name="q" value="<%= q %>" placeholder="Name, phone, email, role, notes" autofocus>
    </label>
    <div class="form-actions">
      <button type="submit" class="primary">Search</button>
    </div>
  </form>
  <div class="panel">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Phone</th>
          <th>Email</th>
          <th>Applications</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (people.length === 0) { %>
          <tr><td colspan="5" class="muted"><%= q ? 'No matching people.' : 'No people yet.' %></td></tr>
        <% } %>
        <% for (const p of people) { %>
          <tr>
            <td>
              <a href="/people/<%= p.person_id %>"><%= p.full_name %></a>
              <% if (p.do_not_contact) { %><span class="pill danger">Do not contact</span><% } %>
            </td>
            <td><%= p.phone %></td>
            <td><%= p.email || '—' %></td>
            <td><%= p.application_count %></td>
            <td class="actions"><a href="/people/<%= p.person_id %>">Open</a></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>

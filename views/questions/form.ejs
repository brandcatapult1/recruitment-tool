<%- include('../partials/header') %>
<%
  const optionsText = question && Array.isArray(question.options)
    ? question.options.join('\n')
    : (question && question.options ? String(question.options) : '');
  const currentType = question ? question.type : '';
  const isCreate = !(question && question.question_id);
%>
<div class="card campaign-glass-tile narrow wide">
  <h1><%= title %></h1>
  <% if (usage && (usage.campaigns > 0 || usage.recordedAnswers > 0)) { %>
    <p class="notice">Used on <%= usage.campaigns %> campaign<%= usage.campaigns === 1 ? '' : 's' %>
      and recorded in <%= usage.recordedAnswers %> application<%= usage.recordedAnswers === 1 ? '' : 's' %>.
      Edits apply to <strong>future</strong> applications only. Answers already submitted keep the
      original wording.</p>
  <% } %>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form method="post">
    <% if (isCreate) { %>
      <label>Brand
        <span class="muted">Can't be changed later.</span>
        <select name="brand_id" required>
          <option value="" disabled <%= question && question.brand_id ? '' : 'selected' %>>Select a brand</option>
          <% for (const b of brands) { %>
            <option value="<%= b.brand_id %>" <%= question && question.brand_id === b.brand_id ? 'selected' : '' %>><%= b.name %></option>
          <% } %>
        </select>
      </label>
    <% } else { %>
      <p class="muted">Brand: <%= question.brand_name %> (can't be changed)</p>
    <% } %>
    <label>Question text
      <input type="text" name="text" required value="<%= question ? question.text : '' %>">
    </label>
    <label>Type
      <select name="type" required>
        <% for (const t of types) { %>
          <option value="<%= t %>" <%= currentType === t ? 'selected' : '' %>><%= label('questionType', t) %></option>
        <% } %>
      </select>
    </label>
    <label>Options
      <span class="muted">One per line; required for Single choice and Multiple choice.</span>
      <textarea name="options" rows="4"><%= optionsText %></textarea>
    </label>
    <div class="form-actions">
      <button type="submit" class="primary">Save</button>
      <a class="btn-secondary" href="/questions">Cancel</a>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1 class="page-title">Question bank</h1>
    <p class="page-sub">Each question belongs to one brand. Editing a question here does not change answers already recorded — each application stores the wording as it was asked.</p>
  </div>
  <a class="btn-primary" href="/questions/new">Add question</a>
</div>
<% for (const b of brands) {
  const rows = questions.filter((q) => q.brand_id === b.brand_id);
%>
<section class="card campaign-glass-tile">
  <h2><%= b.name %></h2>
  <% if (rows.length === 0) { %>
    <p class="muted">No questions yet.</p>
  <% } else { %>
  <div class="panel">
    <table>
      <thead>
        <tr>
          <th>Question</th>
          <th>Type</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% for (const q of rows) { %>
          <tr class="<%= q.active ? '' : 'inactive' %>">
            <td><%= q.text %></td>
            <td><%= label('questionType', q.type) %></td>
            <td><%= q.active ? 'Active' : 'Inactive' %></td>
            <td class="actions">
              <a href="/questions/<%= q.question_id %>/edit">Edit</a>
              <% if (q.active) { %>
                <form method="post" action="/questions/<%= q.question_id %>/deactivate" class="inline">
                  <button type="submit" class="link-button">Deactivate</button>
                </form>
              <% } else { %>
                <form method="post" action="/questions/<%= q.question_id %>/reactivate" class="inline">
                  <button type="submit" class="link-button">Reactivate</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
<% } %>
<%- include('../partials/footer') %>

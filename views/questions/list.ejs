<%- include('../partials/header') %>
<div class="card">
  <div class="card-head">
    <h1>Question bank</h1>
    <a class="button primary" href="/questions/new">Add question</a>
  </div>
  <p class="muted">These questions appear on campaign apply pages. Editing a question here does not
    change answers already recorded — each application stores the wording as it was asked.</p>
  <table>
    <thead>
      <tr>
        <th>Question</th>
        <th>Type</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (questions.length === 0) { %>
        <tr><td colspan="4" class="muted">No questions yet. Add one to start building apply pages.</td></tr>
      <% } %>
      <% for (const q of questions) { %>
        <tr class="<%= q.active ? '' : 'inactive' %>">
          <td><%= q.text %></td>
          <td><%= q.type %></td>
          <td><%= q.active ? 'Active' : 'Inactive' %></td>
          <td class="actions">
            <a href="/questions/<%= q.question_id %>/edit">Edit</a>
            <% if (q.active) { %>
              <form method="post" action="/questions/<%= q.question_id %>/deactivate" class="inline">
                <button type="submit" class="link-button">Deactivate</button>
              </form>
            <% } else { %>
              <form method="post" action="/questions/<%= q.question_id %>/reactivate" class="inline">
                <button type="submit" class="link-button">Reactivate</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>

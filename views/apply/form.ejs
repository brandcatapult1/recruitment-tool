<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= campaign.role_title %> · <%= campaign.apply_page_title %></title>
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/static/fonts/geist-sans-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/static/fonts/geist-sans-700.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/static/apply.css?v=apply2">
</head>
<body>
  <div class="apply-shell">
    <main class="apply">
      <div class="apply-stage">
        <header class="apply-intro">
          <div class="apply-brand">
            <% if (campaign.logo_public_id) { %>
              <img class="apply-logo" src="/brands/<%= campaign.brand_id %>/logo" alt="">
            <% } %>
            <span class="apply-brand-name"><%= campaign.apply_page_title %></span>
          </div>
          <h1 class="apply-title"><%= campaign.role_title %></h1>
          <p class="apply-meta">
            <span><%= campaign.department_name %></span>
            <% if (campaign.show_salary_publicly && (campaign.salary_band_min || campaign.salary_band_max)) { %>
              <span>
                <% const inr = (n) => '₹' + Number(n).toLocaleString('en-IN'); %>
                <% if (campaign.salary_band_min && campaign.salary_band_max) { %>
                  <%= inr(campaign.salary_band_min) %> – <%= inr(campaign.salary_band_max) %>
                <% } else if (campaign.salary_band_min) { %>
                  from <%= inr(campaign.salary_band_min) %>
                <% } else { %>
                  up to <%= inr(campaign.salary_band_max) %>
                <% } %>
              </span>
            <% } %>
          </p>
          <section class="jd"><%- jobDescriptionHtml %></section>
        </header>

        <div class="apply-form">
          <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>

          <form method="post" enctype="multipart/form-data" id="apply-form">
            <input type="hidden" name="submission_id" value="<%= submissionId %>">
            <label class="hp-field" aria-hidden="true">Website
              <input type="text" name="website" tabindex="-1" autocomplete="off">
            </label>

            <section class="apply-section">
              <h2 class="apply-section-label">About you</h2>
              <label class="apply-field">Full name<span class="req" aria-hidden="true">*</span>
                <input type="text" name="full_name" required autocomplete="name" value="<%= values.full_name || '' %>">
              </label>
              <label class="apply-field">Phone<span class="req" aria-hidden="true">*</span>
                <input type="tel" name="phone" required autocomplete="tel" value="<%= values.phone || '' %>">
              </label>
              <label class="apply-field">Email<span class="req" aria-hidden="true">*</span>
                <input type="email" name="email" required autocomplete="email" value="<%= values.email || '' %>">
              </label>
              <div class="apply-field">
                <span id="city-label">Current city<span class="req" aria-hidden="true">*</span></span>
                <div class="city-picker" data-city-picker>
                  <input type="hidden" name="city" id="city-value" required value="<%= values.city || '' %>">
                  <input
                    type="text"
                    class="city-picker-input"
                    id="city-search"
                    role="combobox"
                    aria-labelledby="city-label"
                    aria-autocomplete="list"
                    aria-expanded="false"
                    aria-controls="city-list"
                    autocomplete="off"
                    placeholder="Search city"
                    value="<%= values.city || '' %>"
                  >
                  <ul class="city-picker-list" id="city-list" role="listbox">
                    <% for (const city of cities) { %>
                      <li role="option" data-value="<%= city %>" <%= values.city === city ? 'aria-selected="true"' : '' %>><%= city %></li>
                    <% } %>
                  </ul>
                </div>
              </div>
            </section>

            <section class="apply-section">
              <h2 class="apply-section-label">Your situation</h2>
              <label class="apply-field">Current CTC (annual)
                <input type="number" name="current_comp" min="0" value="<%= values.current_comp || '' %>">
              </label>
              <label class="check">
                <input type="checkbox" name="not_currently_employed" value="true" <%= values.not_currently_employed === 'true' || values.not_currently_employed === 'on' ? 'checked' : '' %>>
                I am not currently employed
              </label>
              <label class="apply-field">Earliest joining date<span class="req" aria-hidden="true">*</span>
                <input type="date" name="earliest_join_date" required value="<%= values.earliest_join_date || '' %>">
              </label>
            </section>

            <section class="apply-section">
              <h2 class="apply-section-label">Your work</h2>
              <label class="apply-field">CV<span class="req" aria-hidden="true">*</span>
                <input type="file" name="cv" accept=".pdf,.doc,.docx,application/pdf" required>
              </label>
              <label class="apply-field">Work links
                <span class="hint">Portfolio, LinkedIn, site — paste links that do not expire. Avoid WeTransfer or other transfer links that lapse.</span>
                <textarea name="work_links" rows="3" placeholder="https://"><%= values.work_links || '' %></textarea>
              </label>
              <label class="apply-field">Or a portfolio file
                <span class="hint">Optional. Use this instead of links if you prefer.</span>
                <input type="file" name="portfolio">
              </label>
              <label class="apply-field">Years of experience in this discipline<span class="req" aria-hidden="true">*</span>
                <input type="number" name="years_in_discipline" min="0" step="0.5" required value="<%= values.years_in_discipline || '' %>">
                <span class="hint">Not total years worked — years in this kind of work.</span>
              </label>
              <label class="apply-field">Why do you want this role?<span class="req" aria-hidden="true">*</span>
                <textarea name="motivation" required maxlength="<%= charLimit %>" data-counter="motivation-count" rows="4"><%= values.motivation || '' %></textarea>
                <span class="count" id="motivation-count">0 / <%= charLimit %></span>
              </label>
            </section>

            <% const deptQs = questions.filter((q) => q.tier === 'department'); %>
            <% const campQs = questions.filter((q) => q.tier === 'campaign'); %>
            <% if (deptQs.length || campQs.length) { %>
              <section class="apply-section">
                <h2 class="apply-section-label">A few specifics</h2>
                <% for (const q of deptQs) { %>
                  <%- include('./question-field', { q, values, charLimit, freeTextTypes }) %>
                <% } %>
                <% for (const q of campQs) { %>
                  <%- include('./question-field', { q, values, charLimit, freeTextTypes }) %>
                <% } %>
              </section>
            <% } %>

            <div class="consent">
              <p>By submitting, you agree that <%= campaign.apply_page_title %> can use these details to consider you for this role and related openings, and to contact you about them. We keep applications for 24 months.</p>
              <p>We’ll be in touch if there’s a next step.</p>
            </div>
            <button type="submit" class="submit" id="submit-btn">Submit application</button>
          </form>
        </div>
      </div>
    </main>
  </div>
  <script>
    document.querySelectorAll('[data-counter]').forEach(function (el) {
      var out = document.getElementById(el.getAttribute('data-counter'));
      function tick() { if (out) out.textContent = (el.value || '').length + ' / ' + el.maxLength; }
      el.addEventListener('input', tick); tick();
    });

    (function cityPicker() {
      var root = document.querySelector('[data-city-picker]');
      if (!root) return;
      var search = document.getElementById('city-search');
      var hidden = document.getElementById('city-value');
      var list = document.getElementById('city-list');
      var items = Array.prototype.slice.call(list.querySelectorAll('[role="option"]'));

      function open() {
        root.classList.add('open');
        search.setAttribute('aria-expanded', 'true');
      }
      function close() {
        root.classList.remove('open');
        search.setAttribute('aria-expanded', 'false');
      }
      function filter(q) {
        var needle = (q || '').trim().toLowerCase();
        items.forEach(function (li) {
          var match = !needle || li.getAttribute('data-value').toLowerCase().indexOf(needle) !== -1;
          li.classList.toggle('hidden', !match);
        });
      }
      function pick(li) {
        var v = li.getAttribute('data-value');
        hidden.value = v;
        search.value = v;
        items.forEach(function (el) { el.setAttribute('aria-selected', el === li ? 'true' : 'false'); });
        close();
      }

      search.addEventListener('focus', function () { open(); filter(search.value); });
      search.addEventListener('input', function () {
        if (hidden.value && search.value !== hidden.value) hidden.value = '';
        open();
        filter(search.value);
      });
      list.addEventListener('mousedown', function (e) {
        var li = e.target.closest('[role="option"]');
        if (li) { e.preventDefault(); pick(li); }
      });
      search.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { close(); search.blur(); }
        if (e.key === 'Enter') {
          e.preventDefault();
          var first = items.find(function (li) { return !li.classList.contains('hidden'); });
          if (first) pick(first);
        }
      });
      document.addEventListener('click', function (e) {
        if (!root.contains(e.target)) close();
      });
    document.getElementById('apply-form').addEventListener('submit', function (e) {
      if (!hidden.value) {
        e.preventDefault();
        search.focus();
        open();
        filter(search.value);
        return;
      }
      var btn = document.getElementById('submit-btn');
      btn.disabled = true; btn.textContent = 'Submitting…';
    });
    })();
  </script>
</body>
</html>

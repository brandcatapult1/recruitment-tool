<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Application received · <%= typeof campaign !== 'undefined' && campaign ? campaign.apply_page_title : 'Careers' %></title>
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/static/fonts/dm-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/static/fonts/dm-sans-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/static/apply.css?v=apply1">
</head>
<body>
  <main class="apply">
    <header class="apply-header">
      <% if (typeof campaign !== 'undefined' && campaign) { %>
        <div class="apply-brand">
          <% if (campaign.logo_public_id) { %>
            <img class="apply-logo" src="/brands/<%= campaign.brand_id %>/logo" alt="">
          <% } %>
          <span class="apply-brand-name"><%= campaign.apply_page_title %></span>
        </div>
      <% } %>
      <h1 class="apply-title">We’ve got your application</h1>
    </header>
    <p class="thanks-lead">Thank you for taking the time. If there’s a next step, someone from our talent team will be in touch.</p>
    <p class="thanks-note">You can close this page.</p>
  </main>
</body>
</html>

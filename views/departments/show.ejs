<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1 class="page-title"><%= department.name %></h1>
    <p class="page-sub"><%= department.brand_name %> · <%= department.active ? 'Active' : 'Inactive' %></p>
  </div>
  <div class="form-row">
    <a class="btn-secondary" href="/departments/<%= department.department_id %>/edit">Edit department</a>
    <a class="btn-primary" href="/departments/<%= department.department_id %>/questions">Set apply questions</a>
  </div>
</div>
<section class="card campaign-glass-tile">
  <h2>Screening qualifiers</h2>
  <% if (!department.screening_qualifiers || department.screening_qualifiers.length === 0) { %>
    <p class="muted">None set.</p>
  <% } else { %>
    <ul><% for (const q of department.screening_qualifiers) { %><li><%= q %></li><% } %></ul>
  <% } %>

  <h2>Feedback dimensions</h2>
  <% if (!department.feedback_dimensions || department.feedback_dimensions.length === 0) { %>
    <p class="muted">None set.</p>
  <% } else { %>
    <ul><% for (const d of department.feedback_dimensions) { %><li><%= d %></li><% } %></ul>
  <% } %>

  <h2>Apply-page questions</h2>
  <p class="muted">Up to 3. Single choice, multiple choice or number only — free text is not allowed here.
    These appear on every campaign in this department.</p>
  <% if (attached.length === 0) { %>
    <p class="muted">None set.</p>
  <% } else { %>
    <ul>
      <% for (const q of attached) { %>
        <li><%= q.text %>
          <span class="muted"><%= label('questionType', q.type) %><%= q.is_required ? ' · required' : '' %></span>
        </li>
      <% } %>
    </ul>
  <% } %>
</section>
<%- include('../partials/footer') %>

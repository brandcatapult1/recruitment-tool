<%- include('../partials/header') %>
<%
  const attachedIds = new Set(attached.map((q) => q.question_id));
  const orderById = {};
  const requiredById = {};
  for (const q of attached) {
    orderById[q.question_id] = q.display_order;
    requiredById[q.question_id] = q.is_required;
  }
%>
<div class="card">
  <div class="card-head">
    <h1><%= department.name %></h1>
    <a class="button primary" href="/departments/<%= department.department_id %>/edit">Edit department</a>
  </div>
  <p class="muted"><%= department.active ? 'Active' : 'Inactive' %></p>

  <h2>Screening qualifiers</h2>
  <% if (!department.screening_qualifiers || department.screening_qualifiers.length === 0) { %>
    <p class="muted">None set.</p>
  <% } else { %>
    <ul><% for (const q of department.screening_qualifiers) { %><li><%= q %></li><% } %></ul>
  <% } %>

  <h2>Feedback dimensions</h2>
  <% if (!department.feedback_dimensions || department.feedback_dimensions.length === 0) { %>
    <p class="muted">None set.</p>
  <% } else { %>
    <ul><% for (const d of department.feedback_dimensions) { %><li><%= d %></li><% } %></ul>
  <% } %>

  <h2>Apply-page questions</h2>
  <p class="muted">Up to 3. Select, multi-select or number only — free text is not allowed here.
    These appear on every campaign in this department.</p>
  <form method="post" action="/departments/<%= department.department_id %>/questions">
    <table>
      <thead>
        <tr><th>Include</th><th>Question</th><th>Order</th><th>Required</th></tr>
      </thead>
      <tbody>
        <% if (selectable.length === 0) { %>
          <tr><td colspan="4" class="muted">Add structured questions to the <a href="/questions">question bank</a> first.</td></tr>
        <% } %>
        <% selectable.forEach((q, i) => { %>
          <tr>
            <td><input type="checkbox" name="selected" value="<%= q.question_id %>" <%= attachedIds.has(q.question_id) ? 'checked' : '' %>></td>
            <td><%= q.text %> <span class="muted"><%= q.type %></span></td>
            <td><input type="number" name="order_<%= q.question_id %>" min="1" class="order-input" value="<%= orderById[q.question_id] || (i + 1) %>"></td>
            <td><input type="checkbox" name="required_<%= q.question_id %>" <%= requiredById[q.question_id] ? 'checked' : '' %>></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div class="form-actions"><button type="submit" class="primary">Save questions</button></div>
  </form>
</div>
<%- include('../partials/footer') %>
